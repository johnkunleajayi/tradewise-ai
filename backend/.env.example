# Copy to .env and supply your local database credentials. Never commit .env.
DATABASE_URL=postgresql+psycopg://tradewise:CHANGE_ME@127.0.0.1:5432/tradewise
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Integration tests require a separate, disposable database ending in _test.
TEST_DATABASE_URL=postgresql+psycopg://tradewise:CHANGE_ME@127.0.0.1:5432/tradewise_test

# Google OAuth server-side login.
# Create a Google OAuth client of type Web application. Set BOTH credentials
# in your private .env when ready; blank values leave Google unconfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact callback in Google Cloud. Match the backend port.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Discovery URL and least-privilege scopes (openid email profile) are fixed
# in app/auth/config.py; credentials must never be exposed as VITE_* variables.

# Server-side sessions; cookies are Secure automatically with an HTTPS callback.
AUTH_SESSION_TTL_SECONDS=86400
AUTH_OAUTH_TTL_SECONDS=600
